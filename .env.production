# Production Environment Variables for uptrail.info
# Copy this file to .env on your production server

# Django Settings
SECRET_KEY=your-secret-key-here-make-it-long-and-random-60-chars-minimum
DEBUG=False
DJANGO_SETTINGS_MODULE=codelearn_lms.settings_production

# Database Configuration (MySQL for production)
DB_ENGINE=django.db.backends.mysql
DB_NAME=ralffmqq_uptrail
DB_USER=ralffmqq_uptrail_user
DB_PASSWORD=~583hkWOKxOu
DB_HOST=localhost
DB_PORT=3306

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/1

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@uptrail.info

# Domain Configuration for uptrail.info
ALLOWED_HOSTS=uptrail.info,www.uptrail.info
CSRF_TRUSTED_ORIGINS=https://uptrail.info,https://www.uptrail.info
CORS_ALLOWED_ORIGINS=https://uptrail.info,https://www.uptrail.info

# Payment Gateway (Razorpay Production)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# YouTube Integration
YOUTUBE_API_KEY=your_youtube_api_key

# Admin Configuration
ADMIN_URL=secure-admin/

# Error Tracking (Optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Session Configuration
SESSION_COOKIE_AGE=3600
SESSION_COOKIE_SECURE=True

# File Upload Limits
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880

# Rate Limiting
RATELIMIT_ENABLE=True